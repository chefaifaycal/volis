{
  "expo": {
    "name": "Volis",
    "slug": "volis",
    "scheme": "volis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/expo/icon.png",
    "ios": {
      "bundleIdentifier": "app.volis.ios",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/expo/icon.png",
        "dark": "./assets/expo/icon-ios-dark.png",
        "tinted": "./assets/expo/icon-ios-tinted.png"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Volis utilise la caméra pour photographier votre colis et scanner le code de remise.",
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "app.volis.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/expo/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/expo/adaptive-icon-background.png",
        "monochromeImage": "./assets/expo/adaptive-icon-monochrome.png",
        "backgroundColor": "#0F766E"
      }
    },
    "web": {
      "favicon": "./assets/expo/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/expo/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F1E8",
          "dark": {
            "image": "./assets/expo/splash-icon-dark.png",
            "backgroundColor": "#121A24"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Caveat-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/JetBrainsMono-Bold.ttf",
            "./assets/fonts/JetBrainsMono-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf"
          ]
        }
      ],
      "expo-localization"
    ]
  }
}