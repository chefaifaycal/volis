# Copier ce fichier en .env (jamais commité) et remplir avec les valeurs du projet.
# Les variables EXPO_PUBLIC_* sont embarquées dans l'application : elles sont PUBLIQUES.
# N'y mettez JAMAIS de secret (clé service_role Supabase, clé secrète Stripe sk_..., etc.).

# Supabase (projet en région ca-central-1)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe : clé PUBLIABLE uniquement (pk_test_... / pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
